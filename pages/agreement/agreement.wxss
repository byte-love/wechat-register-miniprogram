page {
  background: #ffffff;
}

.agreement-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  color: #303133;
  font-size: 28rpx;
  line-height: 1.8;
}

.document-title {
  display: block;
  margin: 8rpx 0 40rpx;
  color: #202124;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
}

.section-title,
.paragraph,
.inline-link {
  display: block;
}

.section-card {
  margin-top: 40rpx;
  padding: 0 0 36rpx;
  border-bottom: 1rpx solid #e2e5e9;
}

.section-heading {
  display: flex;
  align-items: baseline;
  margin-bottom: 22rpx;
}

.section-index {
  flex: 0 0 auto;
  margin-right: 16rpx;
  color: #7a7f87;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}

.section-title {
  color: #202124;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
}

.paragraph {
  margin-bottom: 18rpx;
  color: #3f4348;
  line-height: 1.9;
  text-align: justify;
}

.important,
.important-inline {
  color: #202124;
  font-weight: 700;
}

.paragraph-last {
  margin-top: 18rpx;
  margin-bottom: 0;
}

.paragraph-inline,
.inline-link {
  display: inline;
}

.inline-link {
  color: #245b8f;
  font-weight: 600;
}

.item-list {
  display: flex;
  flex-direction: column;
}

.item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  color: #3f4348;
  line-height: 1.85;
  text-align: justify;
}

.item:last-child {
  margin-bottom: 0;
}

.item-dot {
  flex: 0 0 auto;
  width: 38rpx;
  margin-right: 10rpx;
  color: #606266;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.85;
}

.acknowledge-bar {
  box-sizing: border-box;
  margin-top: 32rpx;
  padding: 18rpx 0;
}

.acknowledge-bar .acknowledge-button {
  width: 100%;
  height: 80rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 6rpx;
  background: #2f6dea;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 80rpx;
  transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
}

.acknowledge-bar .acknowledge-button::after {
  border: 0;
}

.acknowledge-bar .acknowledge-button:active {
  transform: scale(0.98);
}
